# Agent Configuration
NAME = "{{ name }}"
PORT = {{ port }}
TARGET_URL = "{{ target_url }}"
INSTRUCTIONS = """{{ instructions }}
You are a Browser-use agent assigned to navigate and interact with: {{ target_url }}
You use a headless browser to perform tasks.
"""

# Browser-Use Wrapper for Agno/Bindu
# Since browser-use has its own agent loop, we need to bridge it.
# This simple wrapper takes a task description and runs the browser agent.

class BrowserUseTool:
    def __init__(self):
        self.llm = ChatOpenAI(model="gpt-4o")

    async def run_browser_task(self, task: str):
        """Runs a browser automation task."""
        agent = BrowserAgent(
            task=task,
            llm=self.llm,
        )
        result = await agent.run()
        return result

# We need a way to run async tool in synchronous handler if bindufy handler is sync.
# Typically Bindu handlers can be async. Let's assume sync for now and use asyncio.run
def run_browser_task_sync(task: str):
    tool = BrowserUseTool()
    return asyncio.run(tool.run_browser_task(task))

# Define the agent
agent = Agent(
    instructions=INSTRUCTIONS,
    model=OpenAIChat(id="gpt-4o"),
    # We can add a python tool that calls browser-use
    tools=[run_browser_task_sync], 
)

