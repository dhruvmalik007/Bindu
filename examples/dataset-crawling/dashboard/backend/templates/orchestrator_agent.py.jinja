# Agent Configuration
NAME = "{{ name }}"
PORT = {{ port }}
INSTRUCTIONS = """{{ instructions }}
You are the Orchestrator Agent. Your goal is to research a user query and delegate crawling tasks.
1. Analyze the user query.
2. Use Perplexity (via tool) to research the query and find relevant URLs.
3. Decide which specialized agent (Firecrawl or Browser-Use) is best for each URL.
4. Output a plan or delegate the task (simulated delegation for now).
"""

# Perplexity Tool
class PerplexityTool:
    def __init__(self, api_key: str):
        self.api_key = api_key
        self.base_url = "https://api.perplexity.ai/chat/completions"

    def research(self, query: str):
        """
        Researches the query using Perplexity API to find facts and sources.
        """
        payload = {
            "model": "llama-3.1-sonar-small-128k-online",
            "messages": [
                {"role": "system", "content": "Be precise and concise. Return a list of relevant URLs found."},
                {"role": "user", "content": query}
            ]
        }
        headers = {
            "Authorization": f"Bearer {self.api_key}",
            "Content-Type": "application/json"
        }
        response = requests.post(self.base_url, json=payload, headers=headers)
        return response.json()

api_key = "{{ perplexity_api_key }}" or os.getenv("PERPLEXITY_API_KEY")
tools = [DuckDuckGoTools()]
if api_key:
    pplx_tool = PerplexityTool(api_key=api_key)
    tools.append(pplx_tool.research)

# Define the agent
agent = Agent(
    instructions=INSTRUCTIONS,
    model=OpenAIChat(id="gpt-4o"),
    tools=tools, 
)

config = {
    "author": "{{ author }}",
    "name": NAME,
    "description": "{{ description }}",
    "deployment": {"url": f"http://localhost:{PORT}", "expose": True},
    "skills": {{ skills }},
    
    # Observability & Telemetry
    "monitoring": {{ observability.enabled }},
    "telemetry": {{ observability.enabled }},
    {% if observability.enabled and observability.otlp_endpoint %}
    "otlp_endpoint": "{{ observability.otlp_endpoint }}",
    {% endif %}
    {% if observability.enabled and observability.service_name %}
    "otlp_service_name": "{{ observability.service_name }}",
    {% endif %}

    # Storage & Scheduler
    "storage": {
        "type": "{{ storage.type }}",
        {% if storage.connection_string %}
        "connection_string": "{{ storage.connection_string }}",
        {% endif %}
    },
    "scheduler": {
        "type": "{{ storage.type }}", 
    },

    {% if auth.enabled %}
    "auth": {
        "enabled": True,
        "provider": "{{ auth.provider }}",
        "domain": "{{ auth.domain }}",
        "audience": "{{ auth.audience }}",
    },
    {% endif %}

    {% if payment.enabled %}
    "execution_cost": {
        "amount": "{{ payment.amount }}",
        "token": "{{ payment.token }}",
        "network": "{{ payment.network }}",
        "pay_to_address": "{{ payment.pay_to_address }}",
    },
    {% endif %}
}

def handler(messages: list[dict[str, str]]):
    """
    Process incoming messages.
    """
    result = agent.run(input=messages)
    return result

if __name__ == "__main__":
    print(f"Starting Orchestrator agent {NAME} on port {PORT}...")
    bindufy(config, handler)
