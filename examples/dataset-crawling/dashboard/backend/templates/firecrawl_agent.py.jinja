from bindu.penguin.bindufy import bindufy
from agno.agent import Agent
from agno.models.openai import OpenAIChat
from firecrawl import FirecrawlApp
import os

{% if observability.enabled %}
from bindu.observability import setup as setup_observability
# Configure OTEL env vars (recommended pattern)
{% if observability.otlp_endpoint %}
os.environ["OTEL_EXPORTER_OTLP_ENDPOINT"] = "{{ observability.otlp_endpoint }}"
{% endif %}
{% if observability.service_name %}
os.environ["OTEL_SERVICE_NAME"] = "{{ observability.service_name }}"
{% endif %}
{% if observability.service_version %}
os.environ["OTEL_SERVICE_VERSION"] = "{{ observability.service_version }}"
{% endif %}
{% if observability.deployment_environment %}
os.environ["DEPLOYMENT_ENV"] = "{{ observability.deployment_environment }}"
{% endif %}
{% if observability.resource_attributes %}
os.environ["OTEL_RESOURCE_ATTRIBUTES"] = "{{ observability.resource_attributes }}"
{% endif %}
{% if observability.use_batch_processor %}
os.environ["OTEL_USE_BATCH_PROCESSOR"] = "true"
{% if observability.bsp_schedule_delay %}
os.environ["OTEL_BSP_SCHEDULE_DELAY"] = "{{ observability.bsp_schedule_delay }}"
{% endif %}
{% if observability.bsp_max_export_batch_size %}
os.environ["OTEL_BSP_MAX_EXPORT_BATCH_SIZE"] = "{{ observability.bsp_max_export_batch_size }}"
{% endif %}
{% endif %}
# Initialize observability once at startup
setup_observability()
{% endif %}

# Agent Configuration
NAME = "{{ name }}"
PORT = {{ port }}
TARGET_URL = "{{ target_url }}"
INSTRUCTIONS = """{{ instructions }}
You are a Firecrawl-powered agent assigned to crawl: {{ target_url }}
You have access to the Firecrawl API to crawl, scrape, map, and search the web.
"""

# Firecrawl Tool Wrapper
class FirecrawlTools:
    def __init__(self, api_key: str):
        self.app = FirecrawlApp(api_key=api_key)

    def crawl(self, url: str):
        """Crawls a URL and all its subpages."""
        return self.app.crawl_url(url, params={"crawlerOptions": {"limit": 10}})

    def scrape(self, url: str):
        """Scrapes a single URL."""
        return self.app.scrape_url(url)
    
    def map(self, url: str):
        """Maps a website to find all URLs."""
        return self.app.map_url(url)
    
    def search(self, query: str):
        """Searches the web."""
        return self.app.search(query)

api_key = "{{ firecrawl_api_key }}" or os.getenv("FIRECRAWL_API_KEY")
if not api_key:
    raise ValueError("Firecrawl API Key is required")

firecrawl_tools = FirecrawlTools(api_key=api_key)

# Define the agent
agent = Agent(
    instructions=INSTRUCTIONS,
    model=OpenAIChat(id="gpt-4o"),
    tools=[firecrawl_tools], 
)

config = {
    "author": "{{ author }}",
    "name": NAME,
    "description": "{{ description }}",
    "deployment": {"url": f"http://localhost:{PORT}", "expose": True},
    "skills": {{ skills }},
    
    # Observability & Telemetry
    "monitoring": {{ observability.enabled }},
    "telemetry": {{ observability.enabled }},
    {% if observability.enabled and observability.otlp_endpoint %}
    "otlp_endpoint": "{{ observability.otlp_endpoint }}",
    {% endif %}
    {% if observability.enabled and observability.service_name %}
    "otlp_service_name": "{{ observability.service_name }}",
    {% endif %}

    # Storage & Scheduler
    "storage": {
        "type": "{{ storage.type }}",
        {% if storage.connection_string %}
        "connection_string": "{{ storage.connection_string }}",
        {% endif %}
    },
    "scheduler": {
        "type": "{{ storage.type }}", 
    },

    {% if auth.enabled %}
    "auth": {
        "enabled": True,
        "provider": "{{ auth.provider }}",
        "domain": "{{ auth.domain }}",
        "audience": "{{ auth.audience }}",
    },
    {% endif %}

    {% if payment.enabled %}
    "execution_cost": {
        "amount": "{{ payment.amount }}",
        "token": "{{ payment.token }}",
        "network": "{{ payment.network }}",
        "pay_to_address": "{{ payment.pay_to_address }}",
    },
    {% endif %}
}

def handler(messages: list[dict[str, str]]):
    """
    Process incoming messages.
    """
    result = agent.run(input=messages)
    return result

if __name__ == "__main__":
    print(f"Starting Firecrawl agent {NAME} on port {PORT}...")
    bindufy(config, handler)
